{
  "name": "@tansy/theme-storefront",
  "version": "0.1.0",
  "description": "A storefront look for the shop plugin: soft rounded product cards, a product stage with a size picker and quantity stepper, and a two-column cart.",
  "keywords": [
    "tansy-theme"
  ],
  "license": "MIT",
  "author": "Mohamed Salah <mohamedsalahsebai@gmail.com>",
  "homepage": "https://github.com/mhmdsalahsebai/tansy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmdsalahsebai/tansy.git",
    "directory": "themes/storefront"
  },
  "bugs": "https://github.com/mhmdsalahsebai/tansy/issues",
  "exports": {
    ".": "./index.ts",
    "./render": "./render.tsx"
  },
  "files": [
    "*.ts",
    "*.tsx",
    "*.css",
    "schema.json",
    "fonts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tailwindcss --input ./styles.css --output ./theme.css",
    "watch": "tailwindcss --input ./styles.css --output ./theme.css --watch",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@tansy/shop": "^0.1.0",
    "next": "^16.4.5",
    "react": "^19.3.0",
    "tansy": "^0.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
