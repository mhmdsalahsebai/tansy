# A SQLite file for local use, or postgres://user:password@host:5432/name for production.
DATABASE_URL="file:./dev.db"
# Connections the record layer may open on Postgres.
# DATABASE_POOL_SIZE=10
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public URL of this server. Email links are built from it.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32. Encrypts SMTP and OAuth secrets stored in the database.
TANSY_ENCRYPTION_KEY=

# Background work: schedules, jobs, hook and webhook deliveries. See docs/guides/background-work.md.
# On a server that stays up it runs on the server's own timers and needs nothing here.
# On Vercel, Netlify or Lambda it runs when something calls /api/background with
# Authorization: Bearer CRON_SECRET, such as the cron in vercel.json. openssl rand -base64 32
# CRON_SECRET=
# "timers" or "external". Detected from the host when unset.
# TANSY_BACKGROUND=
# How long one call to /api/background may work, in seconds. Keep it under the host's function limit.
# TANSY_BACKGROUND_SECONDS=240

# Uploaded files. Leave S3_BUCKET unset to keep files on local disk, which is for development.
# Set S3_BUCKET for AWS, Cloudflare R2, Backblaze B2, MinIO or any S3-compatible service.
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=
# Or a provider plugin, picked by the first of these that is set. See docs/guides/storage.md.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_PREFIX=
# BUNNY_STORAGE_ZONE=
# BUNNY_STORAGE_PASSWORD=
# BUNNY_STORAGE_REGION=de
# BUNNY_PREFIX=
# A pull zone with Bunny Optimizer and token authentication makes thumbnails. Add its URL to the CSP's img sources.
# BUNNY_CDN_URL=https://example.b-cdn.net
# BUNNY_CDN_TOKEN_KEY=
# A private Vercel Blob store's token.
# BLOB_READ_WRITE_TOKEN=
# BLOB_PREFIX=
# UPLOADTHING_TOKEN=
# UPLOADTHING_PREFIX=
# UPLOADS_DIR=data/uploads
# Local disk refuses to start in production unless this is true.
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
# Largest upload in bytes. Defaults to 50 MiB.
# MAX_UPLOAD_BYTES=52428800

# Backups of the database and uploads. See docs/guides/backups.md.
# openssl rand -base64 32. Encrypts every backup. Keep a copy away from the backups, or they can't be restored.
# TANSY_BACKUP_KEY=
# Cron fields in UTC. Unset makes backups only when someone runs tansy backup.
# TANSY_BACKUP_SCHEDULE="0 3 * * *"
# How many to keep. Older ones are deleted after each backup.
# TANSY_BACKUP_KEEP=7
# false leaves uploads out of backups.
# TANSY_BACKUP_FILES=true
# Where they go: a bucket, with the S3_* credentials unless these are set,
# TANSY_BACKUP_S3_BUCKET=
# TANSY_BACKUP_S3_PREFIX=backups
# TANSY_BACKUP_S3_ENDPOINT=
# TANSY_BACKUP_S3_REGION=
# TANSY_BACKUP_S3_ACCESS_KEY_ID=
# TANSY_BACKUP_S3_SECRET_ACCESS_KEY=
# or a folder, ideally on another disk.
# TANSY_BACKUP_DIR=data/backups
# The folder holding pg_dump, pg_restore and psql, when the ones on PATH don't match the Postgres server's major version.
# TANSY_PG_BIN=/usr/lib/postgresql/17/bin

# Search runs in the database. Set one of these to use an outside engine instead. See docs/guides/search.md.
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_API_KEY=
# MEILISEARCH_INDEX=tansy
# TYPESENSE_HOST=http://127.0.0.1:8108
# TYPESENSE_API_KEY=
# TYPESENSE_COLLECTION=tansy
# ALGOLIA_APP_ID=
# ALGOLIA_API_KEY=
# ALGOLIA_INDEX=tansy

# Request logs: TANSY_PLUGIN_REQUEST_LOGS=true logs every API request, shown under Request logs. Besides the
# database, they can go to a bucket, a log service or the server's output. See docs/plugins/request-logs.md.
# TANSY_PLUGIN_REQUEST_LOGS=true
# REQUEST_LOGS_S3_BUCKET=
# REQUEST_LOGS_S3_PREFIX=request-logs
# REQUEST_LOGS_HTTP_URL=https://logs.example.com/ingest
# REQUEST_LOGS_HTTP_TOKEN=
# REQUEST_LOGS_CONSOLE=true
# Also sends them over OpenTelemetry, to the address below.
# REQUEST_LOGS_OTLP=true

# Audit log over OpenTelemetry: TANSY_PLUGIN_LOGS_OTLP=true sends a copy of the audit log to Grafana, Honeycomb,
# Datadog, Axiom or any OpenTelemetry Collector. The database keeps its own. See docs/plugins/logs-otlp.md.
# TANSY_PLUGIN_LOGS_OTLP=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>
# OTEL_SERVICE_NAME=tansy

# Analytics: TANSY_PLUGIN_ANALYTICS=true counts page views with no cookies. Choose an outside service under
# Analytics → Settings. Self-hosted ones need their address here. See docs/plugins/analytics.md.
# TANSY_PLUGIN_ANALYTICS=true
# PLAUSIBLE_HOST=https://plausible.example.com
# PLAUSIBLE_API_KEY=
# UMAMI_HOST=https://umami.example.com
# UMAMI_API_KEY=
# MATOMO_URL=https://example.matomo.cloud
# MATOMO_TOKEN=
# FATHOM_API_KEY=
# GOOGLE_ANALYTICS_CREDENTIALS=

# Extensions. See docs/EXTENDING.md.
# TANSY_HOOKS_DIR=cms_hooks
# Applied at every startup. Never removes anything.
# TANSY_SCHEMA_FILE=schema.json
# Lets webhooks use http and private addresses. For local development only.
# TANSY_WEBHOOK_ALLOW_PRIVATE=false
# Turns on the example plugin in examples/seo-plugin.
# TANSY_EXAMPLE_SEO=false
# TANSY_EXAMPLE_SEO_COLLECTIONS=posts

# Optional plugins and examples. See docs/EXTENDING.md.
# TANSY_PWNED_PASSWORDS=true

# First-party SEO plugin: seo_title and seo_description fields, and /sitemap.xml built from URL patterns.
# Lists these collections. Each needs a URL pattern. Uses TANSY_SITE_URL, or BETTER_AUTH_URL if that is unset.
# TANSY_SEO_COLLECTIONS=posts,pages
# TANSY_SITE_URL=https://example.com

# Blog plugin: posts, categories, tags, authors, comments and /feed.xml. See docs/plugins/blog.md.
# The blog theme turns it on too. Feeds use TANSY_SITE_URL, or BETTER_AUTH_URL if that is unset.
# TANSY_PLUGIN_BLOG=true
# New comments wait for review (moderated, the default), show at once (open), or are refused (off).
# TANSY_BLOG_COMMENTS=moderated
# Who to email when a comment is waiting for review.
# TANSY_BLOG_NOTIFY=editor@example.com

# LMS plugin: courses, lessons for enrolled learners, progress, quizzes and certificates. See docs/plugins/lms.md.
# TANSY_PLUGIN_LMS=true
# Percent needed to pass a quiz, unless the quiz sets its own. 70 by default.
# TANSY_LMS_PASSING_SCORE=70

# Email plugin: send the site's email through Resend, Postmark, SendGrid, Mailgun, Amazon SES or Brevo instead of SMTP.
# Keys go under Email → Settings. Until they're set, email goes through SMTP. See docs/plugins/email.md.
# TANSY_PLUGIN_EMAIL=true

# CAPTCHA plugin: Cloudflare Turnstile, hCaptcha or reCAPTCHA on sign-in, sign-up, password reset and plugins' forms.
# Keys go under Extensions → CAPTCHA, or here. Until they're set, nothing asks for one. See docs/plugins/captcha.md.
# TANSY_PLUGIN_CAPTCHA=true
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# The sign-in forms that ask for it at first, until changed in the settings. All three when unset.
# TANSY_CAPTCHA_FORMS=signin,signup,forgot-password

# Forms plugin: contact forms and other forms, built from field blocks and put on any page with the Form block.
# Submissions are kept under Forms → Submissions and emailed to these addresses. See docs/plugins/forms.md.
# TANSY_PLUGIN_FORMS=true
# TANSY_FORMS_NOTIFY=you@example.com

# Payments plugin: plans, subscriptions and one-time purchases. Keys go under Payments → Settings. See docs/plugins/payments.md.
# TANSY_PLUGIN_PAYMENTS=true
# The currency of prices that don't name one. usd by default.
# TANSY_PAYMENTS_CURRENCY=usd

# Shop plugin: products, variants, stock, a cart, shipping zones and orders, paid through Payments. See docs/plugins/shop.md.
# TANSY_PLUGIN_SHOP=true

# Subscriptions plugin: plans, what they open, gating collections and members, in one section of the dashboard. Needs TANSY_PLUGIN_PAYMENTS. See docs/plugins/subscriptions.md.
# TANSY_PLUGIN_SUBSCRIPTIONS=true

# Example of plan access: Articles and a Library that subscriptions open, with an access and plans set up. Needs TANSY_PLUGIN_PAYMENTS. See docs/plugins/payments.md §8.
# TANSY_EXAMPLE_PLAN_ACCESS=true

# The public site's theme: blank (default), blog, magazine, storefront, dispatch or academy. blog and magazine need the blog plugin and turn it on; storefront turns on the shop and Payments; dispatch, a newsletter's site, turns on the newsletter and blog plugins; academy, a school's site, turns on the LMS and shows plans when Payments is on. Set the same value for both the build and the server.
# TANSY_THEME=magazine
# TANSY_SITE_TAGLINE="Field notes"
# A headless site's preview route, which receives ?token=. Without it, previews open in this app.
# TANSY_PREVIEW_URL=https://example.com/api/preview
# How long the public site's reads stay cached, in seconds. Any write clears them. 0 turns it off.
# TANSY_SITE_CACHE_SECONDS=30

# AI assistant (plugins/ai): chat that creates and edits content, filling forms, writing fields.
# Choose the provider under AI → Settings and paste its key there, or set it here.
# TANSY_PLUGIN_AI=true
# The provider chosen until changed under AI → Settings: openai, anthropic, google, gateway, mistral, xai, groq, deepseek, openrouter, opencode, commandcode or compatible.
# TANSY_AI_PROVIDER=openrouter
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# AI_GATEWAY_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OPENCODE_API_KEY=
# COMMANDCODE_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
