{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "../../.release/package"
  },
  "include": ["app", "components", "core", "entry", "lib", "routes", "sdk", "types"]
}
