# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# local SQLite databases, wherever they are written
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# scratch folder for local databases, test databases and anything else a run writes
/.data/

# local file storage
/data/
/apps/starter/data/

# backups, and the copy tansy restore saves first
cms-backup-*.tar.gz*
cms-before-restore-*.tar.gz*

# code index
/.codegraph/

# browser tests
/test-results/
/playwright-report/

# package build
/.release
/packages/cms/generated

# generated by tansy sync
.tansy/

# internal design notes and roadmaps. The contributor rules are tracked, in docs/contributing/
/internal/
